<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Recomp</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Recomp encrypted backup</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.recomp.encrypted-backup</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Recomp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>recomp</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_recomp-sync3._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Recomp uses your camera to photograph food for estimates that you review before logging. Photos are sent for analysis only after you confirm.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Recomp reads nutrition, weight, body-fat percentage and waist for local tracking, plus optional workout summaries, steps and sleep for activity context. No Health records are sent to the food AI service.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Recomp saves the calories and macros you confirm, and optionally weight, body-fat percentage and waist readings. Separately reviewed DEXA scans can share total-body weight, body-fat percentage and compatible lean body mass. It updates or removes only its own samples when you edit or delete records.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Recomp uses the local network to discover and sync diary entries directly with your Mac or iPhone.</string>
	<key>RecompAppGroup</key>
	<string>$(RECOMP_APP_GROUP)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Recomp encrypted backup</string>
			<key>UTTypeIdentifier</key>
			<string>app.recomp.encrypted-backup</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>recompbackup</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
