+import Foundation
+// Read-only adapter double. It does not contact Apple Health or the recording apps.
+@MainActor final class ActivityHealthService {
+    var reads = 0, requests = 0
+    var failAuthorization = false
+    var beforeRead: (() async -> Void)?
+    var result = ActivityReadout(steps: [StepDay(date: Date(), count: 100)], refreshedAt: Date())
+    func requestAccess() async throws {
+        requests += 1
+        if failAuthorization { throw CocoaError(.userCancelled) }
+    }
+    func read() async -> ActivityReadout {
+        reads += 1
+        if let beforeRead { self.beforeRead = nil; await beforeRead() }
+        return result
+    }
+}
diff --git a/TestSupport/Audit2Harness/Harness.swift b/TestSupport/Audit2Harness/Harness.swift
new file mode 100644
index 0000000..0ef6e77
--- /dev/null
+++ b/TestSupport/Audit2Harness/Harness.swift
@@ -0,0 +1,81 @@
+import Foundation
+
+@main struct Audit2Harness {
+    @MainActor static func main() async throws {
+        let root = FileManager.default.temporaryDirectory.appendingPathComponent("recomp-audit2-" + UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at: root) }
+        var checks = 0, failures = 0
+        func check(_ value: @autoclosure () -> Bool, _ name: String) {
+            checks += 1
+            if value() { print("PASS: \(name)") } else { failures += 1; print("FAIL: \(name)") }
+        }
+        // Weight-derived maintenance must not remain in today's audit history after its
+        // only weight source is removed by pausing Health. Older snapshots stay historical.
+        let fixture = AdaptiveDemo.stable.data()
+        var state = fixture.state
+        state.healthEnabled = true
+        state.activityPreferences.enabled = true
+        let file = StateFile(url: root.appendingPathComponent("pause.json")); try file.save(state)
+        let health = HealthKitService()
+        health.bodyReads = fixture.points.map { HealthBodySample(id: $0.id, date: $0.date, metric: $0.metric,
+            value: $0.value, sourceName: "Synthetic scale", sourceBundleID: "test.scale", localMeasurementID: nil) }
+        let diary = DiaryStore(fileURL: file.url, health: health)
+        await diary.refreshHealth()
+        check(diary.maintenanceReport.estimate != nil && !diary.state.maintenanceHistory.isEmpty, "imported weights establish a synthetic maintenance snapshot")
+        diary.pauseHealth()
+        check(!diary.state.activityPreferences.enabled, "general Pause Health integration also pauses activity reads")
+        check(diary.bodyPoints.isEmpty && diary.maintenanceReport.estimate == nil, "pause removes imported weights from current analysis")
+        check(diary.state.maintenanceHistory.isEmpty, "pause also removes now-invalid current maintenance snapshot")
+
+        // Save/reopen without recalculation must not silently relabel verified label totals.
+        let original = FoodEntry(name: "Verified label", date: Date(), meal: .lunch,
+            nutrition: Nutrition(calories: 250, protein: 25, carbs: 20, fat: 7), isEstimate: false)
+        let model = MealEstimatorModel(date: original.date, original: original)
+        check(model.entry()?.isEstimate == false, "unchanged verified meal stays verified when reopening its breakdown")
+
+        // Connect/permission completion must fail closed on a real disk-write failure.
+        let activityFile = StateFile(url: root.appendingPathComponent("activity.json"))
+        try activityFile.save(AppState())
+        let activityStore = DiaryStore(fileURL: activityFile.url, health: HealthKitService())
+        try FileManager.default.removeItem(at: activityFile.url)
+        try FileManager.default.createDirectory(at: activityFile.url, withIntermediateDirectories: false)
+        let reader = ActivityHealthService(), activity = ActivityModel(health: reader)
+        await activity.connect(using: activityStore)
+        check(reader.requests == 1, "activity requests system access through its adapter")
+        check(!activityStore.state.activityPreferences.enabled && reader.reads == 0, "failed settings write never starts activity reads")
+        check(activity.error != nil && !activity.authorizing, "failed connect exposes an error and leaves no stuck authorization state")
+        try FileManager.default.removeItem(at: activityFile.url)
+        await activity.connect(using: activityStore)
+        check(activityStore.state.activityPreferences.enabled && reader.reads == 1, "successful persisted opt-in starts activity reads")
+        check(activity.error == nil, "successful retry clears the previous activity connection error")
+        let persistedActivity = try activityFile.load()
+        check(persistedActivity.activityPreferences.enabled, "activity opt-in is durable before reading")
+        reader.beforeRead = { await activity.refresh(enabled: false) }
+        await activity.refresh(enabled: true)
+        check(activity.readout.steps.isEmpty && !activity.busy, "late activity response cannot repopulate a paused readout")
+        let reads = reader.reads
+        reader.beforeRead = { await activity.refresh(enabled: true) }
+        await activity.refresh(enabled: true)
+        check(reader.reads == reads + 1, "simultaneous foreground/preference reads coalesce")
+        check(!activity.busy && !activity.readout.steps.isEmpty, "coalesced read completes normally")
+        let deniedReader = ActivityHealthService(); deniedReader.failAuthorization = true
+        let denied = ActivityModel(health: deniedReader)
+        let deniedStore = DiaryStore(fileURL: root.appendingPathComponent("denied.json"), health: HealthKitService())
+        await denied.connect(using: deniedStore)
+        check(!deniedStore.state.activityPreferences.enabled && deniedReader.reads == 0, "failed permission request starts no read and persists no opt-in")
+
+        // Editing nutrition or actually asking AI must still mark the result estimated.
+        if var item = model.draft?.estimate.items.first {
+            item.nutrition.calories += 50; model.edit(item, locked: true)
+            check(model.entry()?.isEstimate == true, "changed nutrition is still estimated until explicitly verified")
+        }
+        let reused = MealEstimatorModel(date: original.date, original: original)
+        reused.clarification = "Recheck the amount"
+        EstimationService.response = reused.draft!.estimate
+        reused.begin(configuration: EstimatorConfiguration())
+        for _ in 0..<1000 { if !reused.busy { break }; await Task.yield() }
+        check(reused.entry()?.isEstimate == true, "new AI result is estimated even if its totals happen to match")
+        print("AUDIT2: \(checks) checks, \(failures) failures")
+        if failures > 0 { exit(1) }
+    }
+}
diff --git a/TestSupport/NetworkHarness/Harness.swift b/TestSupport/NetworkHarness/Harness.swift
new file mode 100644
index 0000000..96fb17d
--- /dev/null
+++ b/TestSupport/NetworkHarness/Harness.swift
@@ -0,0 +1,89 @@
+import Foundation
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+// Only endpoint/keychain configuration is replaced, to permit synthetic loopback HTTP.
+// The production EstimationService and transport are compiled unchanged below.
+struct EstimatorConfiguration {
+    var accessToken = "synthetic-local-token-00000000000000000000"
+    func endpoint() throws -> URL { URL(string: ProcessInfo.processInfo.environment["RECOMP_TEST_SERVER"]! + "/v1/estimate")! }
+}
+
+@main struct NetworkHarness {
+    static func main() async throws {
+        setbuf(stdout, nil)
+        var count=0,failures=0
+        func check(_ ok: Bool, _ label: String) {count+=1;print("\(ok ? "PASS" : "FAIL"): \(label)");if !ok {failures+=1}}
+        func input(_ mode:String)->EstimateRequest {EstimateRequest(description:mode, clarification:"", images:[], currentEstimate:nil, lockedItemIDs:[], excludedFoods:[])}
+        func request(_ mode:String) async throws -> MealEstimate {try await EstimationService.estimate(input(mode),configuration:EstimatorConfiguration())}
+        func stats() async throws -> [String:Any] {
+            let url=URL(string:ProcessInfo.processInfo.environment["RECOMP_TEST_SERVER"]!+"/stats")!
+            let(data,_)=try await URLSession.shared.data(from:url)
+            return try JSONSerialization.jsonObject(with:data) as! [String:Any]
+        }
+        let success = try await request("ok")
+        check(success.total.calories==200,"actual client decodes a successful localhost response")
+        for mode in ["large-length","large-stream","redirect","invalid-json","wrong-type","bad-photo","server-error"] {
+            do {_ = try await request(mode);check(false,"reject \(mode)")}
+            catch {check(true,"reject \(mode)")}
+            if mode.hasPrefix("large") {
+                try await Task.sleep(nanoseconds:30_000_000)
+                let state = try await stats()[mode] as! [String:Any]
+                check((state["chunks"] as! Int)<15,"\(mode) stops transfer before buffering full body")
+                check(state["closed"] as? Bool == true,"\(mode) closes rejected response")
+            }
+        }
+        let after = try await stats()
+        check((after["redirectHits"] as? Int ?? 0)==0,"redirect target receives no request or bearer token")
+        let pending=Task { try await request("cancel") }
+        for _ in 0..<100 { if (try await stats()["cancel"]) != nil { break }; try await Task.sleep(nanoseconds:5_000_000) }
+        pending.cancel()
+        do {_ = try await pending.value;check(false,"cancelled request fails")}
+        catch {check(true,"cancelled request fails")}
+        try await Task.sleep(nanoseconds:50_000_000)
+        let cancelled = try await stats()["cancel"] as! [String:Any]
+        check(cancelled["closed"] as? Bool==true,"Swift task cancellation closes active HTTP transfer")
+        let recovery=try await request("recovery")
+        check(recovery.total.calories==200,"client recovers after oversized, failed and cancelled requests")
+
+        let exact = try await request("exact-size")
+        check(exact.total.calories == 200, "exact 250,000-byte valid JSON response is accepted")
+        do { _ = try await request("gzip-large"); check(false, "decompressed response is bounded") }
+        catch { check(true, "decompressed response is bounded") }
+        // Exercise cancellation racing completion across many independent sessions.
+        let burst = (0..<100).map { index in Task { try await request("stress-\(index)") } }
+        for index in stride(from: 0, to: burst.count, by: 2) { burst[index].cancel() }
+        var completed = 0, correctUncancelled = 0
+        for (index, task) in burst.enumerated() {
+            do {
+                let meal = try await task.value; completed += 1
+                if index % 2 == 1 && meal.total.calories == 200 { correctUncancelled += 1 }
+            } catch { completed += 1 }
+        }
+        check(correctUncancelled == 50, "all 50 uncancelled requests succeed during cancellation stress")
+        check(completed == 100, "100 cancellation/completion races terminate without a stuck continuation")
+        let preCancelled = Task {
+            // Let the cancellation flag be set, then still ENTER the production client.
+            try? await Task.sleep(nanoseconds: 10_000_000)
+            return try await request("pre-cancelled")
+        }
+        preCancelled.cancel()
+        do { _ = try await preCancelled.value; check(false, "pre-cancelled task is rejected") }
+        catch { check(true, "pre-cancelled task is rejected") }
+        let finalStats = try await stats()
+        check(finalStats["pre-cancelled"] == nil, "pre-cancellation sends no HTTP request")
+        #if RECOMP_BOUNDED_TRANSPORT
+        var timeoutRequest = URLRequest(url: try EstimatorConfiguration().endpoint())
+        timeoutRequest.httpMethod = "POST"
+        timeoutRequest.httpBody = try JSONEncoder().encode(input("timeout"))
+        let began = Date()
+        do {
+            _ = try await BoundedHTTPClient.data(for: timeoutRequest, requestTimeout: 2, resourceTimeout: 0.5)
+            check(false, "overall timeout stops a trickling response")
+        } catch { check((error as? URLError)?.code == .timedOut, "overall deadline returns the timedOut error") }
+        check(Date().timeIntervalSince(began) < 5, "overall timeout is not reset by each received byte")
+        #endif
+        print("NETWORK: \(count) checks, \(failures) failures")
+        if failures>0 {exit(1)}
+    }
+}
diff --git a/TestSupport/NetworkHarness/server.mjs b/TestSupport/NetworkHarness/server.mjs
new file mode 100644
index 0000000..046d167
--- /dev/null
+++ b/TestSupport/NetworkHarness/server.mjs
@@ -0,0 +1,35 @@
+// Local synthetic HTTP server only. No credentials or requests leave loopback.
+import http from 'node:http';
+import {gzipSync} from 'node:zlib';
+import {writeFileSync} from 'node:fs';
+const stats = {};
+const meal = {title:'Synthetic test meal',items:[{id:'test',name:'Test food',portion:'1 portion',nutrition:{calories:200,protein:20,carbs:10,fat:9},confidence:'low',assumptions:[],evidence:[]}],assumptions:[],questions:[]};
+const server = http.createServer(async (req,res) => {
+  if(req.url==='/stats') {res.writeHead(200,{'Content-Type':'application/json'});res.end(JSON.stringify(stats));return;}
+  if(req.url==='/redirect-target') {stats.redirectHits=(stats.redirectHits??0)+1;res.end('should not be reached');return;}
+  let body=''; for await(const chunk of req) body+=chunk;
+  const mode=JSON.parse(body).description;
+  stats[mode]={chunks:0,closed:false,finished:false}; const stat=stats[mode];
+  res.on('close',()=>{stat.closed=true;});
+  if(mode==='large-length'||mode==='large-stream') {
+    const headers={'Content-Type':'application/json'};
+    if(mode==='large-length')headers['Content-Length']=5_000_000;
+    res.writeHead(200,headers);res.flushHeaders();
+    const timer=setInterval(()=>{stat.chunks++;res.write(Buffer.alloc(50_000,32));if(stat.chunks===100){stat.finished=true;clearInterval(timer);res.end();}},5);
+    res.on('close',()=>clearInterval(timer));return;
+  }
+  if(mode==='redirect') {res.writeHead(307,{Location:'/redirect-target'});res.end();return;}
+  if(mode==='exact-size'||mode==='gzip-large') {
+    const text=JSON.stringify(meal).padEnd(mode==='exact-size'?250_000:600_000,' ');
+    const body=mode==='gzip-large'?gzipSync(text):Buffer.from(text);
+    res.writeHead(200,{'Content-Type':'application/json','Content-Length':body.length,...(mode==='gzip-large'?{'Content-Encoding':'gzip'}:{})});res.end(body);stat.finished=true;return;
+  }
+  if(mode==='cancel'||mode==='timeout') {res.writeHead(200,{'Content-Type':'application/json'});res.flushHeaders();const timer=setInterval(()=>{stat.chunks++;res.write(' ');},10);res.on('close',()=>clearInterval(timer));return;}
+  if(mode==='wrong-type') {res.writeHead(200,{'Content-Type':'text/html'});res.end(JSON.stringify(meal));return;}
+  if(mode==='invalid-json') {res.writeHead(200,{'Content-Type':'application/json'});res.end('{');return;}
+  if(mode==='server-error') {res.writeHead(401,{'Content-Type':'application/json'});res.end(JSON.stringify({error:'Synthetic authorization error'}));return;}
+  const result=structuredClone(meal);
+  if(mode==='bad-photo')result.items[0].evidence=[{kind:'label',photoNumber:1,detail:'No image was supplied'}];
+  res.writeHead(200,{'Content-Type':'application/json'});res.end(JSON.stringify(result));stat.finished=true;
+});
+server.listen(0,'127.0.0.1',()=>writeFileSync(process.argv[2],String(server.address().port)));
diff --git a/Tests/RecompCoreTests/SecondAuditTests.swift b/Tests/RecompCoreTests/SecondAuditTests.swift
new file mode 100644
index 0000000..23014ca
--- /dev/null
+++ b/Tests/RecompCoreTests/SecondAuditTests.swift
@@ -0,0 +1,61 @@
+import Foundation
+import XCTest
+#if !RECOMP_NATIVE_TESTS
+@testable import RecompCore
+#endif
+
+final class SecondAuditTests: XCTestCase {
+    func testExtremeStepCountsDoNotCrashRoutineComparison() {
+        let now = Date()
+        let calendar = Calendar.current
+        let rows = (1...14).map { StepDay(date: calendar.date(byAdding: .day, value: -$0,
+            to: calendar.startOfDay(for: now))!, count: $0 <= 7 ? 1e100 : 4000) }
+        XCTAssertNil(ActivityMath.stepComparison(rows, now: now, calendar: calendar))
+    }
+    func testNearZeroPriorStepTotalDoesNotOverflowPercent() {
+        let now = Date()
+        let calendar = Calendar.current
+        let rows = (1...14).map { StepDay(date: calendar.date(byAdding: .day, value: -$0,
+            to: calendar.startOfDay(for: now))!, count: $0 <= 7 ? 8000 : 1e-308) }
+        XCTAssertNil(ActivityMath.stepComparison(rows, now: now, calendar: calendar))
+    }
+    func testStepRepresentationBoundsAndNormalComparison() {
+        let now = Date(), calendar = Calendar.current
+        for count in [-1, Double.nan, Double.infinity, Double(Int.max), 1e100] {
+            XCTAssertFalse(StepDay(date: now, count: count).isValid)
+        }
+        XCTAssertFalse(StepDay(date: Date(timeIntervalSince1970: .infinity), count: 1000).isValid)
+        XCTAssertTrue(StepDay(date: now, count: 0).isValid)
+        XCTAssertTrue(StepDay(date: now, count: 8000).isValid)
+        let rows = (1...14).map { StepDay(date: calendar.date(byAdding: .day, value: -$0,
+            to: calendar.startOfDay(for: now))!, count: $0 <= 7 ? 8000 : 4000) }
+        let text = ActivityMath.stepComparison(rows, now: now, calendar: calendar)
+        XCTAssertTrue(text?.contains("8000/day") == true)
+        XCTAssertTrue(text?.contains("100% higher") == true)
+    }
+    private let instant = Date(timeIntervalSince1970: 1_789_732_800)
+    func testStorageDayKeyIsGregorianEvenWithOtherSystemCalendar() {
+        var gregorian = Calendar(identifier: .gregorian)
+        gregorian.timeZone = TimeZone(identifier: "America/Los_Angeles")!
+        for identifier: Calendar.Identifier in [.buddhist, .hebrew, .islamicCivil, .japanese] {
+            var calendar = Calendar(identifier: identifier); calendar.timeZone = gregorian.timeZone
+            XCTAssertEqual(DayReview.key(instant, calendar: calendar), DayReview.key(instant, calendar: gregorian), "Storage dates must not change with the display calendar: \(identifier)")
+        }
+    }
+    func testCompleteFoodDaysCanBeInvalidatedWithBuddhistCalendar() {
+        var calendar = Calendar(identifier: .buddhist); calendar.timeZone = TimeZone(identifier: "America/Los_Angeles")!
+        let review = DayReview(dayKey: DayReview.key(instant, calendar: calendar), timeZoneID: calendar.timeZone.identifier,
+            confirmedAt: instant, total: .startingTargets, estimatedCalorieFraction: 0, includedHealth: false)
+        var state = AppState(); state.dayReviews = [review]
+        XCTAssertTrue(review.isValid)
+        state.invalidateReviews(for: [instant])
+        XCTAssertTrue(state.dayReviews.isEmpty, "Editing a meal must clear its completion even with a non-Gregorian calendar")
+    }
+    func testStoredGregorianDayDecodesInDifferentDisplayCalendar() throws {
+        var calendar = Calendar(identifier: .buddhist); calendar.timeZone = TimeZone(identifier: "America/Los_Angeles")!
+        var gregorian = Calendar(identifier: .gregorian); gregorian.timeZone = calendar.timeZone
+        let review = DayReview(dayKey: DayReview.key(instant, calendar: gregorian), timeZoneID: calendar.timeZone.identifier,
+            confirmedAt: instant, total: .startingTargets, estimatedCalorieFraction: 0, includedHealth: false)
+        XCTAssertEqual(review.date(calendar: calendar), gregorian.startOfDay(for: instant))
+    }
+}
